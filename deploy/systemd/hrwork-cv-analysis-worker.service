[Unit]
Description=HRWork CV Analysis Queue Worker
After=network.target mysql.service mariadb.service

[Service]
Type=simple
User=huntnugie
Group=huntnugie
WorkingDirectory=/var/www/hrwork
ExecStart=/usr/bin/php /var/www/hrwork/artisan queue:work database --queue=cv-analysis --sleep=3 --tries=1 --timeout=240
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=300

[Install]
WantedBy=multi-user.target
